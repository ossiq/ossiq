    "@vitest/utils": "4.1.10",
    "@vue-macros/common": "3.1.4",
    "@vue/compiler-core": "3.5.40",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
